# Copy this file to .env and fill in the values.
#
# EXPO_PUBLIC_* values are bundled into the app (safe: the publishable key maps
# to the anon role and is protected by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Setup scripts ONLY (scripts/db-setup.js). Never import this in app code.
# Use the "Session pooler" connection string if the direct host is unreachable.
SUPABASE_DB_URL=

# Standalone Android build ONLY (EAS APK, Run 4). Expo Go does not need it.
# Read by app.config.js — never by app code, and never commit the real key.
GOOGLE_MAPS_ANDROID_API_KEY=
